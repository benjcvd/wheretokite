    "WhereToKite Pro" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WhereToKite Pro"
          }
        }
      }
    },
    "WhereToKite gives estimates from weather forecasts, not safety advice. Conditions on the water can differ: check the wind, the weather and the local rules on site. You decide whether to ride, at your own risk." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WhereToKite da estimaciones a partir de previsiones meteorológicas, no consejos de seguridad. Las condiciones en el agua pueden ser distintas: comprueba el viento, el tiempo y las normas locales en el spot. Tú decides si navegas, bajo tu propia responsabilidad."
          }
        }
      }
    },
