    "Tap every size you own." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca cada talla que tengas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touche chaque taille que tu as."
          }
        }
      }
    },
    "Tap the map on the water side" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el mapa del lado del agua"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touche la carte côté eau"
          }
        }
      }
    },
    "Tell us about you and your kites once. We match every spot's wind to your gear and give you a straight answer." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuéntanos una vez cómo eres y qué cometas tienes. Comparamos el viento de cada spot con tu equipo y te damos una respuesta clara."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parle-nous une fois de toi et de tes ailes. On compare le vent de chaque spot à ton matériel et on te donne une réponse claire."
          }
        }
      }
    },
    "Thanks! We'll look into it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Gracias! Lo revisaremos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merci ! On regarde ça."
          }
        }
      }
    },
    "That day can't be forecast." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay previsión para ese día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de prévision pour ce jour."
          }
        }
      }
    },
    "The beach direction isn't confirmed by a second map yet, so on- and offshore may be off." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La orientación de la playa aún no está confirmada por un segundo mapa, así que onshore y offshore pueden no ser exactos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
