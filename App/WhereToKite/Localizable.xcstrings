    "Scores are computed from weather forecasts, which can be wrong, especially for gusts, local effects, storms and squalls." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las puntuaciones se calculan a partir de previsiones meteorológicas, que pueden fallar, sobre todo en rachas, efectos locales, tormentas y turbonadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notes sont calculées à partir de prévisions météo, qui peuvent se tromper, surtout pour les rafales, les effets locaux, les orages et les grains."
          }
        }
      }
    },
    "Scores use the standard weights on the free plan" : {
