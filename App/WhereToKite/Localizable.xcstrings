    "Always check conditions on site before riding, never ride alone in strong or offshore wind, and stay within your level." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba siempre las condiciones en el spot antes de navegar, nunca navegues solo con viento fuerte u offshore, y no vayas más allá de tu nivel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifie toujours les conditions sur place avant de naviguer, ne navigue jamais seul par vent fort ou offshore, et reste dans ton niveau."
          }
        }
      }
    },
